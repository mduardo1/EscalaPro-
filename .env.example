# Copie para .env. Nunca envie o .env ao GitHub.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development permite HTTP local; production exige HTTPS e cookies Secure.
APP_ENV=development
FLASK_DEBUG=0
APP_TIMEZONE=America/Sao_Paulo

# Opcional: caminho dentro do projeto. Padrão: instance/escalapro.sqlite3.
DATABASE_PATH=instance/escalapro.sqlite3

# Utilizados apenas no comando flask --app run create-admin.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
# Defina entre 12 e 128 caracteres, sem senha padrão.
ADMIN_PASSWORD=

# SMTP: preencha com os dados do seu provedor. Não há envio pelo console.
# STARTTLS (normalmente porta 587) e SSL direto (normalmente 465) são exclusivos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# PostgreSQL: vazio mantém o SQLite local. Obrigatório em produção, com TLS.
# Nunca coloque uma URL real neste arquivo de exemplo.
DATABASE_URL=
DB_POOL_SIZE=3
DB_TIMEOUT=3

# Hosts separados por vírgula. Obrigatório em produção (sem esquema https://).
TRUSTED_HOSTS=
# Ative somente após confirmar o peer/CIDR e os saltos do proxy na hospedagem.
PROXY_HOPS=0
# Opcional: números diferentes para X-Forwarded-For e X-Forwarded-Proto.
PROXY_FOR_HOPS=0
PROXY_PROTO_HOPS=0
TRUSTED_PROXY_NETWORKS=

# Local: smtp preserva Gmail; Render Free requer API HTTPS (resend).
# disabled bloqueia solicitações que precisam de e-mail.
MAIL_TRANSPORT=smtp
MAIL_FROM=
RESEND_API_KEY=
# memory preserva o fluxo local. Em produção use outbox e execute mail-worker.
EMAIL_DELIVERY_MODE=memory
# Gere uma chave diferente de SECRET_KEY (não gera/salva automaticamente):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_OUTBOX_KEY=

# Apenas para uma restauração explícita em banco PostgreSQL vazio e separado.
RESTORE_DATABASE_URL=

# Opcional: usado somente por scripts/seed_demo.py e scripts/run_demo.py.
# A demo ignora o .env; passe --database ou defina no processo PowerShell.
# Único diretório permitido: instance/demo/; sufixo obrigatório: .demo.sqlite3.
DEMO_DATABASE_PATH=
